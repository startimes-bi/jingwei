# Copy to a protected project .env; do not put real credentials in Git.
FEISHU_REPORTING_ENV_PATH=/path/to/controlled/bi-plus-reporting/.env
FEISHU_REPORTING_CHAT_NAME=BI Plus Reporting
FEISHU_SPREADSHEET_BASE_URL=https://<tenant>.feishu.cn/sheets
JINGWEI_MYSQL_ENV_PATH=/path/to/controlled/mysql-mgw-stage-readonly.env
JINGWEI_MYSQL_DATABASE=mgw
GALAXY_CEO_PORTAL_SPREADSHEET_TOKEN=replace-with-spreadsheet-token
GALAXY_CEO_PORTAL_REGION_SPREADSHEET_TOKEN=replace-with-region-spreadsheet-token
