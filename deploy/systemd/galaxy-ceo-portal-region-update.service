[Unit]
Description=Update Galaxy CEO Portal MGW region data in Feishu
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/wangzp/projects/jingwei
EnvironmentFile=/home/wangzp/projects/jingwei/.env
Environment=PYTHONUNBUFFERED=1
TimeoutStartSec=4h
ExecStart=/usr/bin/python3 /home/wangzp/projects/jingwei/src/galaxy_ceo_portal_region_daily_update.py --max-retries 3 --retry-interval-seconds 3600 --query-chunk-days 7
